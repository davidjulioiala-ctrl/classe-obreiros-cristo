# Configuração mínima do sistema
# Gere um valor aleatório forte e mantenha-o permanente.
# Alterar JWT_SECRET invalida sessões e impede a leitura dos segredos 2FA cifrados.
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Ligação à base de dados MySQL
DATABASE_URL=mysql://utilizador:palavra-passe@localhost:3306/classe_obreiros

NODE_ENV=production
PORT=3000

# Opcional: usado apenas para criar o primeiro administrador
INITIAL_ADMIN_BOOTSTRAP_TOKEN=defina-um-token-inicial-forte
